# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="REPLACE_WITH_APP_URL"

# DATABASE_URL: PostgreSQL connection URI for SQLAlchemy
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/search_recs"

# REDIS: Caching server coordinates
REDIS_HOST="localhost"
REDIS_PORT=6379

# ELASTICSEARCH: Retrieval search engine URL
ELASTICSEARCH_HOSTS="http://localhost:9200"

# MLFLOW: Experiment tracking server URI
MLFLOW_TRACKING_URI="http://localhost:5000"

